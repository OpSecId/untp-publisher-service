# Copy to `.env` in this folder (gitignored) for local development.

# Optional API origin (omit to use Vite proxy `/api`).
# VITE_API_BASE_URL=

# Optional: paste a valid publisher JWT to skip clipboard sign-in while developing.
# Never set this for production builds — Vite inlines VITE_* into the bundle.
# VITE_DEV_PUBLISHER_TOKEN=
